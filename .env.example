# Template for your secrets file.
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Paste your values from the Spotify Developer Dashboard into .env.
# .env is listed in .gitignore, so git will never save it. This template is safe to save
# because it has no real values.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the Redirect URI in the Spotify dashboard character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
